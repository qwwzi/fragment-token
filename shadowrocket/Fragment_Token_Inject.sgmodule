#!url=https://raw.githubusercontent.com/qwwzi/fragment-token/main/shadowrocket/Fragment_Token_Inject.sgmodule
#!name=Fragment Token Inject
#!desc=注入Token

#  在此处填写Toke   ⬇️
#!arguments=Token:

[MITM]
hostname = %APPEND% fragment.com

[Script]
InjectStelToken = type=http-request,script-path=https://raw.githubusercontent.com/qwwzi/fragment-token/main/shadowrocket/InjectStelToken.js,pattern=^https://fragment\.com(?:/|$),requires-body=0,max-size=0,script-update-interval=0,engine=jsc,argument=token={{{Token}}}
